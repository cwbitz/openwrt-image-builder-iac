# ===== Ansible =====
# hosts.yml is local-only (contains your real build host); hosts.yml.example is committed.
inventory/hosts.yml
# group_vars/builder/main.yml is local-only (operators may customize it); the
# committed template is group_vars/builder/main.yml.example.
inventory/group_vars/builder/main.yml
# host_vars/ is host-scoped and local-only; ONLY the variant.example/ folder
# is committed (its main.yml and vault.yml.example templates).
inventory/host_vars/*
!inventory/host_vars/variant.example/
collections/
.cache/
.ansible/
*.retry
*.log

# ===== Build artifacts / scratch =====
# Keep the artifacts/ directory in the repo (tracked via .gitkeep); ignore the
# fetched build artifacts inside it. Builder-side scratch lives under ~/.cache.
artifacts/*
!artifacts/.gitkeep
bin/

# ===== Secrets / keys =====
*.pem
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.key
*.p12
*.pfx
.env
.env.*
# All vault*.yml stay OUT of the repo (secrets are local-only, not committed).
# Only *.example templates are committed (re-included below).
**/*vault*.yml
!**/*.example
# The shared helpers role's read/write vault tasks are code, not secret data.
!roles/helpers/tasks/read_vault.yml
!roles/helpers/tasks/write_vault.yml

# ===== Python / tooling =====
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== tool managers (asdf/mise) =====
# Per-machine tool overrides; the committed project config is `.tool-versions`.
.mise.local.toml
mise.local.toml
.mise/

# ===== OS / editor =====
.DS_Store
Thumbs.db
*.swp
*~
.idea/
# Commit the shared workspace settings + vendored YAML schemas; ignore the rest.
.vscode/*
!.vscode/settings.json
!.vscode/schemas/
