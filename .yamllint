---
# yamllint config. Rendered template files (*.tpl, *.j2) are excluded because
extends: default

rules:
  comments:
    min-spaces-from-content: 1
  line-length:
    max: 160
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  document-start:
    present: true
    level: warning

ignore:
  - "*.tpl"
  - "*.j2"
  - "collections/"
  - ".ansible/"
  - ".cache/"
  - "**/vault.yml"
  - "**/vault.yml.example"
  - ".build/"
