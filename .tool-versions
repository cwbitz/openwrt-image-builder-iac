# Control-node toolchain — the single source of truth for local + CI, in standard
# asdf `.tool-versions` format (read by both asdf and mise):
#   mise install     # or: asdf install
#
# `ansible-core` has no asdf plugin: mise resolves it via its pypi backend (an
# isolated venv). Collections are pinned in requirements.yml; the lint tools use
# mise's pipx backend (with asdf, install them via `pipx install`).
python 3.11.15
ansible-core 2.19.11

# Lint tools, pinned so local and CI use one version.
pipx:ansible-lint 26.6.0
pipx:yamllint 1.38.0
