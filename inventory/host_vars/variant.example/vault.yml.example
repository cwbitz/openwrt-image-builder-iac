# Example per-variant firmware vault. Copy to host_vars/<variant>/vault.yml and
# fill in real values, then encrypt in place:
#   make vault-init                                 # one-time
#   make vault-edit VARIANT=<variant>               # encrypts plaintext first, then edits
# host_vars/<variant>/vault.yml is gitignored; only the variant.example/
# folder is committed.
#
# Connection secrets do NOT belong here: the SSH connection identity is shared
# by every variant and lives in inventory/group_vars/builder/vault.yml (see its
# vault.yml.example).

# --- Firmware secrets --------------------------------------------------------
# Root login password baked into the generated image (module: root-password).
# Leave empty to skip.
vault_openwrt_root_password: CHANGE_ME_root_password

# PPPoE WAN password baked into the generated image (module: pppoe). Leave empty
# to skip.
vault_openwrt_pppoe_password: CHANGE_ME_pppoe_password
