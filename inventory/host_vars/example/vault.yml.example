# Per-machine firmware secrets. Copy to host_vars/<machine>/vault.yml and encrypt:
#   make vault-init
#   make vault-edit HOST=<machine>   # encrypts plaintext first, then edits
# Connection secrets are machine-wide: see group_vars/builder/vault.yml.example.
#
# Each secret is a DICT keyed by VARIANT name (the `name` in build_variants);
# the role looks the current variant's value up by that name, so main.yml needs
# no wiring. A variant whose sub-key is empty (or absent) skips the module. Add
# one sub-key per variant.

# Root login password baked into the images (module: root-password).
vault_openwrt_root_password:
  main: CHANGE_ME_main_root_password
  side: CHANGE_ME_side_root_password

# PPPoE WAN password baked into the images (module: pppoe).
vault_openwrt_pppoe_password:
  main: CHANGE_ME_main_pppoe_password
  side: CHANGE_ME_side_pppoe_password
