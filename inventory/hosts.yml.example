---
# Static inventory: the build machine(s). Copy this file to `hosts.yml`
# (gitignored, local-only).
#
# One inventory host = ONE physical build machine. A machine builds one or more
# VARIANTS (target/profile/settings), declared in host_vars/<machine>/main.yml
# as `openwrt_variants`; every variant shares the machine's `ansible_host`, so
# `make build` builds them in parallel on it.
#
# Do NOT set ansible_user here: the connection identity comes from
# group_vars/all/main.yml. Run `make host-bootstrap` once per machine first.
#
# Building on the control node is also possible (`ansible_connection: local`,
# `ansible_host: 127.0.0.1`). Add another machine as a sibling under `builder`.
all:
  children:
    builder:
      hosts:
        openwrt-ib-prod-1:
          ansible_host: CHANGE_ME_HOST_IP
