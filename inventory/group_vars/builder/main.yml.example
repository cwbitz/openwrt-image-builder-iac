---
# ==============================================================================
# Machine-wide operator overrides for the `builder` group
# (inventory/group_vars/builder/main.yml.example)
# ==============================================================================
# Copy to inventory/group_vars/builder/main.yml (`make host-init` creates it) to
# change a shared value for every build machine; an empty copy is valid. One
# inventory host = one build machine; its variants live in
# host_vars/<machine>/main.yml (`build_variants`).

# --- SSH connection identities (non-secret; passwords stay in vault.yml) ------
# Probed in order [ansible, admin, root] by `make host-bootstrap`; build/info
# connect as `ansible`. Each identity takes its password from the shared vault
# and/or a key path here (SSH prefers the key; empty = not used). A pubkey path
# is authorized for that account during bootstrap.
host_admin_username: "admin"
host_ansible_ssh_pubkey_file: ""
host_ansible_ssh_privkey_file: ""
host_admin_ssh_pubkey_file: ""
host_admin_ssh_privkey_file: ""
host_root_ssh_pubkey_file: ""
host_root_ssh_privkey_file: ""

# --- Optional human 'admin' account -------------------------------------------
# Create/repair the optional human 'admin' account during `make host-bootstrap`.
# It always gets a password (generated into the shared vault when empty) plus any
# configured key. Default false: no admin account is managed (least privilege).
create_admin_account: false

# --- Host security (role sshd; make build EXTRA='--tags sshd') ------------------
# Key-only SSH administration, OFF by default: it closes password login, so it is
# only safe once a keyed login survives it. Root policy is independent.
sshd_hardening_enabled: false
sshd_permit_root_login: "no"
