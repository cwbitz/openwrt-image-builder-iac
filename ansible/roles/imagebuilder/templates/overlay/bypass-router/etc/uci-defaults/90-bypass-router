#!/bin/sh

# Bypass router first-boot configuration. Gateway and DNS usually point at the
# main router's LAN IP address.

{% if openwrt_bypass_lan_ip | length > 0 %}
uci set network.lan.ipaddr={{ openwrt_bypass_lan_ip | quote }}
{% endif %}

{% if openwrt_bypass_gateway | length > 0 %}
uci set network.lan.gateway={{ openwrt_bypass_gateway | quote }}
{% endif %}

{% if openwrt_bypass_dns | length > 0 %}
uci -q delete network.lan.dns
{% for dns in openwrt_bypass_dns %}
uci -q add_list network.lan.dns={{ dns | quote }}
{% endfor %}
{% endif %}

{% if openwrt_bypass_disable_dhcp | bool %}
# Ignore the whole interface (disables DHCPv4, DHCPv6 and RA), plus explicitly
# disable the DHCPv4 server on the LAN interface.
uci set dhcp.lan.ignore='1'
uci set dhcp.lan.dhcpv4='disabled'
{% endif %}

uci commit network dhcp
