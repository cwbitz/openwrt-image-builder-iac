---
# Example per-host vault. Copy to host_vars/<your-host>/vault.yml and fill in
# real values, then encrypt in place:
#   make ans-vault-init                         # one-time: create the vault password
#   make ans-vault-encrypt HOST=<your-host>     # encrypt the plaintext vault
#   make ans-vault-edit HOST=<your-host>        # edit it afterwards
# host_vars/<host>/vault.yml is gitignored; only the example/ folder is committed.
#
# The connection probe tries users in this order (least privilege):
#   ansible  ->  admin (if set)  ->  root
# each with a key first, then a password. Only configured credentials are tried.

# --- 'ansible' automation user (preflight) -----------------------------------
# Path on the CONTROL node to the PUBLIC key installed for the build host's
# 'ansible' automation user. When empty, the user logs in with the generated
# password only. Key login is preferred when set.
vault_host_ansible_ssh_pubkey_file: /home/example/.ssh/id_ed25519_ans.pub
# NOTE: vault_host_ansible_password is AUTO-GENERATED into vault.yml by the
# preflight (never set it by hand; existing values are never rotated).

# --- Fallback: admin user (existing account on the build host) ---------------
# Leave vault_host_admin_user empty to skip the admin fallback. When set, the
# probe tries it (key then password) after 'ansible' and before 'root'.
vault_host_admin_user: ""
vault_host_admin_ssh_pubkey_file: ""
vault_host_admin_password: ""

# --- Fallback: root ----------------------------------------------------------
# Tried last. A key is used by the SSH agent when loaded; the password lets a
# fresh host be reached before the 'ansible' user exists.
vault_host_root_ssh_pubkey_file: ""
vault_host_root_password: ""

# --- Firmware secrets --------------------------------------------------------
# Root login password baked into the generated image (module: root-password).
# Leave empty to skip.
vault_openwrt_root_password: CHANGE_ME_root_password

# PPPoE WAN password baked into the generated image (module: pppoe). Leave empty
# to skip.
vault_openwrt_pppoe_password: CHANGE_ME_pppoe_password
