---
# Static inventory for the ImageBuilder host. This file is local-only
# (gitignored) — copy this example to `hosts.yml`.
#
# By default the CONTROL node (where you run make) and the BUILD host (the
# managed machine running Docker) are TWO SEPARATE machines on the LAN. Replace
# the desensitized address below with your builder's LAN IP/hostname and make
# sure SSH works with one of the credentials configured in the vault.
#
# Do NOT set ansible_user here: the connection probe (playbooks/connect.yml)
# selects it per run, trying 'ansible' first, then an optional admin user, then
# 'root' (key before password, only configured credentials). The preflight
# provisions the 'ansible' user (generated password + optional key +
# passwordless sudo). The FIRST run must connect as root or a sudo-capable user.
#
# Building on the control node itself is also possible: set
# `ansible_connection: local` and `ansible_host: 127.0.0.1`.
#
# Host-scoped settings live in host_vars/<host>/: main.yml (build config, copy
# from host_vars/example/) and vault.yml (secrets, copy from
# host_vars/example/vault.yml.example). The directory name MUST match the
# inventory host name.
all:
  children:
    builder:
      hosts:
        openwrt-ib-prod-1:
          ansible_host: 192.0.2.10 # TODO: your builder host's LAN IP/hostname
